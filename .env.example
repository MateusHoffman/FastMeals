# Copie para `.env` na raiz: cp .env.example .env
# Docker Compose lê `.env` automaticamente para substituir ${VAR} no compose.

# --- Postgres (Compose + credenciais compartilhadas) ---
POSTGRES_USER=fastmeals
POSTGRES_PASSWORD=fastmeals123
POSTGRES_DB=fastmeals
# Porta no host quando o serviço `db` está no Compose
POSTGRES_HOST_PORT=5433

# Prisma / scripts no host (benchmark, backend local com `docker compose up -d db`)
DATABASE_URL=postgresql://fastmeals:fastmeals123@127.0.0.1:5433/fastmeals

# --- JWT ---
JWT_SECRET=local-dev-jwt-secret-min-32-chars-change-me!!
JWT_REFRESH_SECRET=local-dev-refresh-secret-min-32-change!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- API ---
PORT=3001
NODE_ENV=development
HOST=127.0.0.1
TRUST_PROXY=false
# Deixe false em avaliação/produção (README: 100 req/min por IP)
DISABLE_RATE_LIMIT=false

# Só containers Compose (não altere salvo necessidade)
# DOCKER_API_HOST=0.0.0.0
# DOCKER_TRUST_PROXY=1
# WEB_HOST_PORT=3000

# --- SPA / cookies ---
SPA_ORIGIN=http://localhost:3000
CORS_ORIGIN=
COOKIE_SECURE=false

# --- Frontend (build Docker / Vite) ---
VITE_API_URL=/api

# Seed opcional (YYYY-MM-DD)
SEED_ANCHOR_DATE=

# --- Observabilidade (Grafana = UI; Prometheus só interno ao Compose) ---
# API_HOST_PORT=3001
# GRAFANA_HOST_PORT=3002
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
